# Copy this file to .env and fill in real values before running the server.

# A local MongoDB instance, or a free MongoDB Atlas cluster connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/ruet_carrier_hub

# Any long random string — used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

PORT=5000

# Must match the frontend's VITE_API_URL origin for CORS
CLIENT_ORIGIN=http://localhost:5173
